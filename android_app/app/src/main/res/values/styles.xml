<resources>
    <style name="Theme.JARVIS" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/stark_cyan</item>
        <item name="colorPrimaryVariant">@color/stark_dark</item>
        <item name="colorOnPrimary">@color/stark_black</item>
        <item name="android:windowBackground">@color/stark_black</item>
        <item name="android:statusBarColor">@color/stark_black</item>
        <item name="android:navigationBarColor">@color/stark_black</item>
    </style>

    <style name="Theme.JARVIS.Fullscreen" parent="Theme.JARVIS">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
</resources>
