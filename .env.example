# J.A.R.V.I.S. Core Neural Operating System - Environment Variables Example
# Copia este archivo a .env y completa tus credenciales.

# Google Gemini API Key (Requerido para el núcleo neural de JARVIS)
# Obtén tu clave en: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# ElevenLabs API Key (Opcional - Si no se provee o expira cuota, el sistema conmuta automáticamente a Edge-TTS Mexican Neural)
ELEVENLABS_API_KEY=your_elevenlabs_key_here

# Puerto de ejecución (Opcional - Render lo provee automáticamente)
PORT=5000
